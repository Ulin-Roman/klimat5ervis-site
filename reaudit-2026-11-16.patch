--- a/assets/audit-20261116/fixes.css
+++ b/assets/audit-20261116/fixes.css
@@ -9,3 +9,25 @@
   .product-tabs__content { overflow-wrap: anywhere; }
   .product-tabs__content table { max-width: 100%; }
 }
+
+/* Keep the intrinsic proportions when fixed-height containers constrain an image. */
+.stock-slider__img img[width], .catalog__img img[width] {
+  width: auto;
+  height: auto;
+  max-width: 100%;
+  max-height: 100%;
+  object-fit: contain;
+}
+/* Improve text contrast without changing the site's layout or brand icons. */
+.ks-header .ks-brand small, .page .advantages p, .page .stock-slider__article,
+.main-footer .logo__text span, .main-footer .main-footer__agreement,
+.main-footer .main-footer__bottom p { color: #5d6570; }
+.page .product-item__tag--new { background-color: #207b0b; color: #fff; }
+.page .product-item__button, .page .feedback > a:last-child { background-color: #0076ac; color: #fff; }
+.main-footer .user__item-text a[href^="https://t.me/"] { color: #075b87 !important; }
+.main-footer .user__item-text a[href^="https://wa.me/"] { color: #176b3e !important; }
+/* Separate quantity inputs and buttons, keeping every target at least 24px. */
+.page .product-item__add-to-cart { height: 50px; }
+.page .product-item__add-to-cart .nice-number { display: block; flex: 0 0 72px; width: 72px; padding-right: 26px; margin-right: 6px; }
+.page .product-item__add-to-cart .nice-number input { box-sizing: border-box; width: 46px !important; height: 50px; padding: 0; text-align: center; }
+.page .product-item__add-to-cart .nice-number button { width: 24px; height: 24px; }
