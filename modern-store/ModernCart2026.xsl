<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:output method="html" encoding="utf-8" omit-xml-declaration="yes"/><xsl:decimal-format name="ru" decimal-separator="," grouping-separator=" "/><xsl:template match="/"><xsl:apply-templates select="shop"/></xsl:template><xsl:template match="shop"><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Корзина — Климат-Сервис</title><style>@font-face{font-family:Open Sans;src:url(/images/t8903001/fonts/opensans-regular.woff2) format('woff2');font-weight:400;font-display:swap}@font-face{font-family:Open Sans;src:url(/images/t8903001/fonts/opensans-semibold.woff2) format('woff2');font-weight:600;font-display:swap}:root{--ink:#182c37;--muted:#536874;--blue:#006b89;--line:#dde5e9;--paper:#f5f7f8}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--paper);font:15px/1.6 'Open Sans',Arial,sans-serif}button,input,select{font:inherit}a{color:inherit;text-decoration:none}a:hover{color:var(--blue)}img{max-width:100%;display:block}a:focus-visible,input:focus-visible,button:focus-visible{outline:3px solid var(--blue);outline-offset:3px}.wrap{width:min(1230px,calc(100% - 48px));margin:auto}.skip{position:fixed;top:-70px;left:20px;z-index:1001;padding:12px;background:#fff}.skip:focus{top:12px}.notice{padding:8px 20px;text-align:center;background:#e7eff2;font-size:12px}.notice a{text-decoration:underline}.header{position:sticky;top:0;z-index:1000;border-bottom:1px solid var(--line);background:#fff}.header-inner{display:flex;min-height:82px;align-items:center;gap:28px}.brand{font-size:19px;font-weight:600;letter-spacing:-.5px;color:var(--blue)}.brand small{display:block;font-weight:400;font-size:10px;letter-spacing:1px;color:var(--muted)}.header nav{display:flex;gap:24px;margin-left:auto;font-size:13px}.cart{padding:10px 16px;background:#e7f2f6;border-radius:9px;font-size:13px}.footer{margin-top:72px;padding:36px 0;background:#edf1f3;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}.footer .wrap{display:flex;justify-content:space-between;gap:30px}.footer p{margin:8px 0}.basket-main{min-height:46vh;padding-top:32px;padding-bottom:20px}.breadcrumbs{margin-bottom:20px;font-size:13px;color:var(--muted)}h1{margin:0 0 28px;font-size:32px;line-height:1.25;letter-spacing:-.7px}h2{margin:0 0 18px;font-size:22px;line-height:1.3}.basket-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:28px;align-items:start}.basket-items{display:grid;gap:14px}.basket-item{padding:22px;display:grid;grid-template-columns:112px minmax(0,1fr) auto;gap:22px;background:#fff;border:1px solid var(--line);border-radius:14px;align-items:start}.basket-photo{width:112px;height:100px;object-fit:contain}.basket-name{overflow-wrap:anywhere;font-size:16px;font-weight:600;line-height:1.5}.basket-article,.basket-each{color:var(--muted);font-size:12px;margin:7px 0}.basket-item-controls{display:flex;align-items:center;gap:20px;margin-top:14px}.basket-quantity label{display:block;font-size:12px;color:var(--muted);margin-bottom:4px}.basket-quantity input{width:82px;max-width:100%;height:42px;padding:7px 10px;border:1px solid #b8cad3;border-radius:8px;color:var(--ink);background:white}.basket-remove{padding:10px 0;border:0;background:transparent;color:#607580;text-decoration:underline;cursor:pointer;font-size:12px;min-height:44px}.basket-line-total{font-size:20px;font-weight:600;white-space:nowrap}.basket-summary{background:white;border:1px solid var(--line);border-radius:14px;padding:26px;position:sticky;top:104px}.basket-totals{margin:0}.basket-totals div{display:flex;justify-content:space-between;gap:12px;margin:12px 0}.basket-totals dt{color:var(--muted)}.basket-totals dd{margin:0;white-space:nowrap}.basket-grand{border-top:1px solid var(--line);padding-top:16px;font-size:21px;font-weight:600}.basket-grand dt{color:var(--ink)}.basket-coupon{display:block;font-size:13px;margin:22px 0 12px}.basket-coupon input{display:block;width:100%;height:44px;margin-top:7px;padding:10px 12px;border:1px solid #b8cad3;border-radius:8px;background:#fff}.basket-button{display:inline-flex;justify-content:center;align-items:center;min-height:48px;padding:11px 18px;border:1px solid var(--blue);border-radius:9px;background:var(--blue);color:#fff;font-weight:600;cursor:pointer;text-align:center;line-height:1.4}.basket-button:hover{background:#006b89;color:#fff}.basket-button-secondary{background:#fff;color:var(--blue)}.basket-button-secondary:hover{background:#edf7fa;color:var(--blue)}.basket-summary .basket-button{width:100%;margin-top:12px}.basket-note{font-size:12px;color:var(--muted);margin:15px 0 0}.basket-continue{display:inline-block;margin-top:24px;text-decoration:underline;color:var(--blue)}.basket-empty{max-width:640px;padding:44px;background:#fff;border:1px solid var(--line);border-radius:16px}.basket-empty p{color:var(--muted);margin:0 0 24px}.basket-alert{padding:14px 18px;margin-bottom:20px;border:1px solid #e9bc77;border-radius:9px;background:#fff7e9}.basket-postponed{margin-top:24px}.basket-postponed .basket-item{opacity:.8}.basket-discount{color:#13794b}.basket-summary a{text-decoration:underline}@media(max-width:1000px){.header nav a:not(:first-child){display:none}.basket-layout{grid-template-columns:minmax(0,1fr) 290px;gap:18px}.basket-item{grid-template-columns:80px minmax(0,1fr);padding:18px;gap:16px}.basket-photo{width:80px;height:80px}.basket-line-total{grid-column:2}.basket-summary{padding:20px}}@media(max-width:760px){.wrap{width:calc(100% - 32px)}.notice{font-size:10px;padding:6px 16px}.header-inner{min-height:68px;gap:12px}.brand{font-size:15px}.brand small{font-size:8px;letter-spacing:0}.header nav{display:none}.cart{margin-left:auto;font-size:12px;padding:8px 10px}.basket-main{padding-top:24px}h1{font-size:27px;margin-bottom:22px}.basket-layout{grid-template-columns:1fr}.basket-item{grid-template-columns:76px minmax(0,1fr);gap:14px;padding:16px}.basket-name{font-size:14px}.basket-photo{width:76px;height:76px}.basket-item-controls{gap:18px;flex-wrap:wrap}.basket-line-total{font-size:20px}.basket-summary{position:static;margin-top:8px;padding:22px}.basket-empty{padding:28px 22px}.footer .wrap{flex-direction:column;gap:16px}.footer{padding-bottom:100px}.basket-summary{padding-bottom:80px}}.header-phone{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:13px;white-space:nowrap;min-height:44px;color:var(--blue)}.header-phone svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linejoin:round;stroke-linecap:round}@media(max-width:760px){.header-phone{width:36px;flex-shrink:0;margin-left:auto}.header-phone span{display:none}.header .cart{margin-left:0}.header-inner{gap:8px}}</style></head><body>
				<a class="skip" href="#main">К содержимому</a><div class="notice">Тест нового интерфейса · актуальные товары и цены · используется корзина рабочего магазина · <a href="/category/">Основной каталог</a></div><header class="header"><div class="wrap header-inner"><a class="brand" href="/modern-home/">КЛИМАТ-СЕРВИС<small>Оборудование · монтаж · сервис</small></a><nav aria-label="Навигация"><a href="/modern-catalog/">Каталог</a><a href="/modern-delivery/">Доставка и оплата</a><a href="/modern-contacts/">Контакты</a></nav><a class="header-phone" href="tel:+79054113948" aria-label="Позвонить: +7 (905) 411-39-48"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h3l2 5-2 2c1 2 2 3 4 4l2-2 5 2v3c0 2-2 4-4 3C9 19 5 15 3 7 2 5 5 3 7 3Z"/></svg><span>+7 (905) 411-39-48</span></a><a class="cart" href="/modern-cart/">Корзина</a></div></header>
				<main class="wrap basket-main" id="main"><div class="breadcrumbs"><a href="/modern-catalog/">Каталог</a> / Корзина</div><h1>Ваша корзина</h1><xsl:if test="modern_cart_message != ''"><div class="basket-alert" role="alert"><xsl:value-of select="modern_cart_message"/></div></xsl:if><xsl:choose><xsl:when test="count(shop_cart)=0"><section class="basket-empty"><h2>В корзине пока нет товаров</h2><p>Выберите кондиционер в каталоге. Здесь можно проверить состав покупки и перейти к оформлению.</p><a class="basket-button" href="/modern-catalog/">Перейти в каталог</a></section></xsl:when><xsl:otherwise><form action="{modern_cart_path}" method="post"><input type="hidden" name="cart_token" value="{modern_cart_token}"/><div class="basket-layout"><section><div class="basket-items"><xsl:apply-templates select="shop_cart[postpone=0]"/></div><xsl:if test="shop_cart[postpone!=0]"><section class="basket-postponed"><h2>Отложенные товары</h2><p class="basket-note">Эти товары не входят в итоговую сумму. Их можно вернуть в покупку через основной магазин.</p><div class="basket-items"><xsl:apply-templates select="shop_cart[postpone!=0]"/></div></section></xsl:if><a class="basket-continue" href="/modern-catalog/">Продолжить покупки</a></section><aside class="basket-summary" aria-label="Итог заказа"><h2>Итого</h2><dl class="basket-totals"><div><dt>Товаров</dt><dd><xsl:value-of select="sum(shop_cart[postpone=0]/quantity)"/></dd></div><xsl:for-each select="shop_purchase_discount"><div class="basket-discount"><dt><xsl:value-of select="name"/></dt><dd>−<xsl:value-of select="format-number(discount_amount,'### ##0,##','ru')"/> ₽</dd></div></xsl:for-each><div class="basket-grand"><dt>Сумма</dt><dd><xsl:value-of select="format-number(total_amount,'### ##0,##','ru')"/> ₽</dd></div></dl><label class="basket-coupon">Промокод<input type="text" name="coupon_text" maxlength="200" value="{coupon_text}" autocomplete="off"/></label><button type="submit" name="recount" value="1" class="basket-button basket-button-secondary">Пересчитать корзину</button><xsl:if test="count(shop_cart[postpone=0]) &gt; 0 and total_amount &gt;= minAllPrice"><button type="submit" formaction="/category/cart/" name="step" value="1" class="basket-button">Перейти к оформлению</button></xsl:if><p class="basket-note">Далее откроется оформление в магазине. Итог пересчитывается по актуальным ценам.</p><p class="basket-note"><a href="/modern-delivery/">Условия доставки и оплаты</a></p></aside></div></form></xsl:otherwise></xsl:choose></main><footer class="footer"><div class="wrap"><div><strong>КЛИМАТ-СЕРВИС</strong><p>Климатические решения для дома и бизнеса.<br/>Москва и Московская область.</p></div><div><strong><a href="tel:+79054113948">+7 (905) 411-39-48</a></strong><p>Москва, ул. Перовская, 20<br/><a href="/modern-delivery/">Доставка и оплата</a> · <a href="/modern-contacts/">Контакты</a></p></div></div></footer><style>
					/* Messenger launcher — isolated from the header and checkout controls. */
					#ks-messenger-widget{--ks-chat-offset:0px;position:fixed;right:calc(24px + env(safe-area-inset-right,0px));bottom:calc(24px + env(safe-area-inset-bottom,0px) + var(--ks-chat-offset));z-index:998;font:600 14px/1.3 "Open Sans",Arial,sans-serif}
					#ks-messenger-widget *{box-sizing:border-box}
					#ks-messenger-widget .ks-chat-toggle{display:flex;align-items:center;justify-content:center;width:60px;height:60px;padding:0;border:0;border-radius:50%;color:#fff;background:#0089c9;box-shadow:0 6px 24px #036b9b40;cursor:pointer;transition:background .18s,transform .18s}
					#ks-messenger-widget .ks-chat-toggle:hover{background:#0373a7;transform:translateY(-2px)}
					#ks-messenger-widget .ks-chat-toggle svg{width:40px;height:40px;display:block}
					#ks-messenger-widget .ks-chat-close{display:none}
					#ks-messenger-widget .ks-chat-toggle[aria-expanded="true"] .ks-chat-bubble{display:none}
					#ks-messenger-widget .ks-chat-toggle[aria-expanded="true"] .ks-chat-close{display:block}
					#ks-messenger-widget .ks-chat-panel{position:absolute;right:0;bottom:74px;display:flex;flex-direction:column;gap:10px;width:60px;max-width:calc(100vw - 32px);max-height:calc(100vh - 120px - var(--ks-chat-offset));max-height:calc(100dvh - 120px - var(--ks-chat-offset));overflow:auto;padding:4px;animation:ks-chat-in .18s ease-out}
					#ks-messenger-widget .ks-chat-panel[hidden]{display:none!important}
					#ks-messenger-widget .ks-chat-link{display:flex;align-items:center;justify-content:center;gap:0;min-height:48px;color:#183342;text-decoration:none;flex-shrink:0;border-radius:26px;outline-offset:0}
					#ks-messenger-widget .ks-chat-logo{display:flex;align-items:center;justify-content:center;flex:0 0 48px;width:48px;height:48px;border-radius:0;background:transparent;box-shadow:none}
					#ks-messenger-widget .ks-chat-logo img,#ks-messenger-widget .ks-chat-logo svg{display:block;width:44px;height:44px;max-width:none}
					#ks-messenger-widget .ks-chat-toggle:focus-visible,#ks-messenger-widget .ks-chat-link:focus-visible{outline:3px solid #f5bd27;outline-offset:3px}
					@keyframes ks-chat-in{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
					@media(max-width:600px){#ks-messenger-widget{right:calc(16px + env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px) + var(--ks-chat-offset))}#ks-messenger-widget .ks-chat-toggle{width:56px;height:56px}#ks-messenger-widget .ks-chat-panel{bottom:68px}}
					@media(prefers-reduced-motion:reduce){#ks-messenger-widget .ks-chat-panel{animation:none}#ks-messenger-widget .ks-chat-toggle{transition:none}}
				</style>
				<div id="ks-messenger-widget">
					<button type="button" class="ks-chat-toggle" aria-label="Открыть мессенджеры" title="Написать нам" aria-expanded="false" aria-controls="ks-chat-panel">
						<svg viewBox="0 0 64 60" aria-hidden="true" focusable="false"><g class="ks-chat-bubble"><path d="M32 4C17.1 4 5 14.1 5 26.5C5 33.1 8.5 39 14.4 43.1L10 55L24.3 48.1C26.8 48.7 29.4 49 32 49C46.9 49 59 38.9 59 26.5C59 14.1 46.9 4 32 4Z" fill="white"/><g fill="#0089c9"><circle cx="23" cy="26.5" r="3"/><circle cx="32" cy="26.5" r="3"/><circle cx="41" cy="26.5" r="3"/></g></g><path class="ks-chat-close" d="m21 19 22 22m0-22L21 41" fill="none" stroke="white" stroke-width="3" stroke-linecap="round"/></svg>
					</button>
					<div id="ks-chat-panel" class="ks-chat-panel" role="group" aria-label="Написать в мессенджере" hidden="hidden">
						<a class="ks-chat-link" href="https://t.me/klimat5servis" target="_blank" rel="noopener noreferrer" aria-label="Написать в Telegram"><span class="ks-chat-logo"><img src="/assets/header-20261116/telegram.svg" width="38" height="38" alt=""/></span></a>
						<a class="ks-chat-link" href="https://max.ru/u/f9LHodD0cOLjX0SKaPjyc-__Xtd96IrNpMNkx4pqxmQmNL8yuBC4ysq5LRg" target="_blank" rel="noopener noreferrer" aria-label="Написать в MAX"><span class="ks-chat-logo"><img src="/assets/footer-20261116/max.webp" width="38" height="38" alt=""/></span></a>
						<a class="ks-chat-link" href="https://wa.me/79054113948" target="_blank" rel="noopener noreferrer" aria-label="Написать в WhatsApp"><span class="ks-chat-logo"><svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="16" cy="16" r="16" fill="#25d366"/><path d="M23.3 8.7a10.2 10.2 0 0 0-16 12.2L6 26l5.2-1.4A10.2 10.2 0 0 0 23.3 8.7ZM16 24a8.4 8.4 0 0 1-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.3 8.3 0 1 1 16 24Z" fill="#fff"/><path d="M12.4 10.8c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.6.1-.8.4-.3.3-1.1 1-1.1 2.4s1.1 2.8 1.3 3c.1.2 2.1 3.2 5.2 4.4 2.6 1 3.1.8 3.6.7.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.4l-2.1-1c-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-.8-1.8Z" fill="#fff"/></svg></span></a>
					</div>
				</div>
				<script>
					(function () {
					'use strict';
					var root = document.getElementById('ks-messenger-widget');
					if (!root) return;
					var toggle = root.querySelector('.ks-chat-toggle');
					var panel = root.querySelector('.ks-chat-panel');
					function close(restoreFocus) {
					panel.hidden = true;
					toggle.setAttribute('aria-expanded', 'false');
					toggle.setAttribute('aria-label', 'Открыть мессенджеры');
					if (restoreFocus) toggle.focus();
					}
					toggle.addEventListener('click', function () {
					var open = panel.hidden;
					panel.hidden = !open;
					toggle.setAttribute('aria-expanded', String(open));
					toggle.setAttribute('aria-label', open ? 'Закрыть мессенджеры' : 'Открыть мессенджеры');
					});
					document.addEventListener('click', function (event) {
					if (!root.contains(event.target)) close(false);
					});
					document.addEventListener('keydown', function (event) {
					if (panel.hidden) return;
					if (event.key === 'Escape') {
					event.preventDefault();
					close(root.contains(document.activeElement));
					}
					});
					root.addEventListener('focusout', function (event) {
					if (event.relatedTarget) {
					if (!root.contains(event.relatedTarget)) close(false);
					}
					});
					var notice = document.getElementById('ks-cookie-notice');
					function position() {
					var offset = 0;
					if (notice) {
					if (!notice.hidden) offset = notice.getBoundingClientRect().height + 12;
					}
					root.style.setProperty('--ks-chat-offset', offset + 'px');
					}
					if (notice) {
					new MutationObserver(position).observe(notice, {attributes:true, subtree:true, attributeFilter:['hidden','class']});
					}
					window.addEventListener('resize', position);
					position();
					}());
	</script></body></html></xsl:template>
<xsl:template match="shop_cart"><xsl:variable name="canonical"><xsl:choose><xsl:when test="shop_item/modification_id != 0 and shop_item/shop_item/url != ''"><xsl:value-of select="shop_item/shop_item/url"/></xsl:when><xsl:otherwise><xsl:value-of select="shop_item/url"/></xsl:otherwise></xsl:choose></xsl:variable><xsl:variable name="link"><xsl:choose><xsl:when test="starts-with($canonical,'/category/')"><xsl:value-of select="concat('/modern-catalog/',substring-after($canonical,'/category/'))"/></xsl:when><xsl:otherwise><xsl:value-of select="$canonical"/></xsl:otherwise></xsl:choose></xsl:variable><article class="basket-item"><input type="hidden" name="warehouse_{shop_item/@id}" value="{shop_warehouse_id}"/><xsl:if test="postpone!=0"><input type="hidden" name="postpone_{shop_item/@id}" value="1"/></xsl:if><a href="{$link}" tabindex="-1" aria-hidden="true"><xsl:choose><xsl:when test="shop_item/image_small != ''"><img class="basket-photo" sizes="112px" src="{shop_item/dir}{shop_item/image_small}" width="112" height="100" alt=""/></xsl:when><xsl:when test="shop_item/shop_item/image_small != ''"><img class="basket-photo" sizes="112px" src="{shop_item/shop_item/dir}{shop_item/shop_item/image_small}" width="112" height="100" alt=""/></xsl:when><xsl:otherwise><span class="basket-note">Без фотографии</span></xsl:otherwise></xsl:choose></a><div><a class="basket-name" href="{$link}"><xsl:value-of select="shop_item/name"/></a><xsl:if test="shop_item/marking != ''"><p class="basket-article">Артикул: <xsl:value-of select="shop_item/marking"/></p></xsl:if><p class="basket-each"><xsl:value-of select="format-number(shop_item/price,'### ##0,##','ru')"/> ₽ за единицу</p><div class="basket-item-controls"><div class="basket-quantity"><label for="quantity_{shop_item/@id}">Количество</label><input id="quantity_{shop_item/@id}" name="quantity_{shop_item/@id}" type="number" min="0" max="9999" step="any" inputmode="decimal" value="{quantity}"/></div><button class="basket-remove" type="submit" name="remove" value="{shop_item/@id}" formnovalidate="formnovalidate" aria-label="Удалить {shop_item/name}">Удалить</button></div></div><strong class="basket-line-total"><xsl:value-of select="format-number(shop_item/price * quantity,'### ##0,##','ru')"/> ₽</strong></article></xsl:template></xsl:stylesheet>