<?xml version="1.0" encoding="utf-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:output method="html" encoding="utf-8" omit-xml-declaration="yes" doctype-system="about:legacy-compat"/><xsl:decimal-format name="ru" decimal-separator="," grouping-separator=" "/>
	<xsl:template match="/"><xsl:apply-templates select="shop"/></xsl:template>
	<xsl:template match="shop"><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Каталог — новый интерфейс Климат-Сервис</title><meta name="theme-color" content="#f5f7f8"/><style><![CDATA[@font-face{font-family:Open Sans;src:url(/images/t8903001/fonts/opensans-regular.woff2) format('woff2');font-weight:400;font-display:swap}@font-face{font-family:Open Sans;src:url(/images/t8903001/fonts/opensans-semibold.woff2) format('woff2');font-weight:600;font-display:swap}:root{--ink:#182c37;--muted:#536874;--blue:#007d9f;--line:#dde5e9;--paper:#f5f7f8}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--paper);font:15px/1.6 'Open Sans',Arial,sans-serif}button,input,select{font:inherit}a{color:inherit;text-decoration:none}a:hover{color:var(--blue)}img{max-width:100%;display:block}a:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid var(--blue);outline-offset:4px}.wrap{width:min(1230px,calc(100% - 48px));margin:auto}.notice{padding:8px 20px;text-align:center;background:#e7eff2;font-size:12px}.notice a{text-decoration:underline}.header{position:sticky;top:0;z-index:10;border-bottom:1px solid var(--line);background:#fff}.header-inner{display:flex;min-height:82px;align-items:center;gap:28px}.brand{font-size:19px;font-weight:600;letter-spacing:-.5px;color:var(--blue)}.brand small{display:block;font-weight:400;font-size:10px;letter-spacing:1px;color:var(--muted)}nav{display:flex;gap:24px;margin-left:auto;font-size:13px}.cart{border:1px solid var(--line);border-radius:13px;padding:10px 18px;font-size:13px}.intro{margin:36px 0 26px}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted)}h1{font-size:36px;font-weight:600;letter-spacing:-1px;line-height:1.3;margin:10px 0}.intro p{font-size:14px;color:var(--muted);max-width:700px}.layout{display:grid;grid-template-columns:230px minmax(0,1fr);gap:24px}.filters{padding:22px;border:1px solid var(--line);border-radius:22px;background:#fff;height:max-content}.filters h2{font-size:16px;margin:0 0 22px;font-weight:600}.field{display:block;margin-bottom:20px}.field>span{font-size:12px;font-weight:600;display:block;margin-bottom:8px}input,select{width:100%;max-width:100%;min-width:0;min-height:44px;border:1px solid #cedbe1;border-radius:11px;padding:10px;background:#fff;color:var(--ink);font-size:13px}.range{display:flex;gap:8px}.range label{min-width:0}.range small{font-size:11px;color:var(--muted)}.btn{min-height:44px;display:inline-flex;justify-content:center;align-items:center;padding:11px 16px;border:1px solid var(--blue);background:var(--blue);color:white;border-radius:12px;font-size:12px;font-weight:600;cursor:pointer}.btn:hover{background:#006783;color:white}.filters .btn{width:100%}.reset{display:block;text-align:center;font-size:12px;text-decoration:underline;margin-top:13px}.toolbar{display:flex;justify-content:space-between;gap:12px;margin:0 0 16px;font-size:12px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.product{padding:20px;border:1px solid var(--line);border-radius:22px;background:white;min-width:0;display:flex;flex-direction:column}.product-image{height:185px;display:flex;align-items:center;justify-content:center;margin-bottom:18px}.product-image img{height:100%;width:100%;object-fit:contain}.product h2{font-size:13px;line-height:1.65;font-weight:600;overflow-wrap:anywhere;margin:0 0 20px;min-height:65px}.sku{font-size:10px;color:var(--muted);margin-bottom:9px}.bottom{margin-top:auto}.price{font-weight:600;font-size:23px;letter-spacing:-.6px}.old{font-size:12px;color:var(--muted);display:block}.actions{display:flex;gap:8px;margin-top:15px}.actions .btn{flex:1;white-space:nowrap}.secondary{background:white;border-color:var(--line);color:var(--ink)}.secondary:hover{background:#eaf5f7;color:var(--ink)}.pagination{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:12px;margin:28px 0}.pagination span{font-size:12px;color:var(--muted)}.empty{padding:36px;border:1px solid var(--line);border-radius:22px;background:white;grid-column:1/-1}.footer{margin-top:52px;border-top:1px solid var(--line);background:#e9eef1;padding:30px 0}.footer .wrap{display:flex;justify-content:space-between;gap:25px;font-size:12px}.footer p{margin:0;color:var(--muted)}.footer strong{display:block;margin-bottom:7px}.skip{position:absolute;top:-100px;padding:12px;background:white;z-index:100}.skip:focus{top:10px}@media(max-width:1100px){nav a:nth-child(2){display:none}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:210px minmax(0,1fr)}.header-inner{gap:20px}.brand{font-size:17px}}@media(max-width:760px){.wrap{width:calc(100% - 32px)}.notice{font-size:10px}.header-inner{min-height:64px;gap:10px}.brand{font-size:13px;white-space:nowrap}.brand small{display:none}nav{gap:10px;font-size:12px}nav a:not(:first-child){display:none}.cart{padding:9px 12px;font-size:11px}.intro{margin-top:26px}h1{font-size:28px}.intro p{font-size:12px}.layout{display:flex;flex-direction:column;gap:22px}.filters{padding:18px}.filters form{display:grid;grid-template-columns:1fr 1fr;gap:14px}.filters h2{margin-bottom:16px}.field{margin:0;min-width:0}.field.search{grid-column:1/-1}.filters .btn{align-self:end}.reset{align-self:center;margin:0}.grid{gap:10px}.product{padding:13px;border-radius:18px}.product-image{height:130px}.product h2{font-size:12px;min-height:96px;margin-bottom:12px}.price{font-size:21px}.actions{flex-direction:column;gap:8px}.actions .btn{font-size:11px;min-height:44px}.footer .wrap{flex-direction:column;gap:18px}.pagination{gap:9px}}@media(max-width:359px){.wrap{width:calc(100% - 24px)}.brand{font-size:11px}nav{font-size:11px}.cart{padding:9px;font-size:10px}.header-inner{gap:8px}.product{padding:11px}.price{font-size:19px}.product-image{height:110px}h1{font-size:25px}}]]></style></head><body>
				<a class="skip" href="#main">К содержимому</a><div class="notice">Тест нового интерфейса · актуальные товары и цены · используется корзина рабочего магазина · <a href="/category/">Основной каталог</a></div><header class="header"><div class="wrap header-inner"><a class="brand" href="/">КЛИМАТ-СЕРВИС<small>Оборудование · монтаж · сервис</small></a><nav aria-label="Навигация"><a href="/modern-catalog/">Каталог</a><a href="/delivery/">Доставка и оплата</a><a href="/kontakty/">Контакты</a></nav><a class="cart" href="/category/cart/">Корзина</a></div></header>
				<main id="main" class="wrap"><div class="intro"><span class="eyebrow">Для дома и бизнеса</span><h1>Каталог климатической техники</h1><p>Подберите оборудование по названию и стоимости. Цены рассчитывает магазин; характеристики и наличие доступны в карточке модели.</p></div><div class="layout"><aside class="filters"><h2>Подобрать модель</h2><form method="get" action="/modern-catalog/"><label class="field search"><span>Модель или производитель</span><input type="search" name="q" value="{modern_q}" maxlength="100" placeholder="Например, Ballu"/></label><div class="field"><span>Цена, ₽</span><div class="range"><label><small>От</small><input type="number" name="min" min="0" step="1" aria-label="Цена от" value="{modern_min}"/></label><label><small>До</small><input type="number" name="max" min="0" step="1" aria-label="Цена до" value="{modern_max}"/></label></div></div><label class="field"><span>Сортировка</span><select name="sort"><option value="name"><xsl:if test="modern_sort='name'"><xsl:attribute name="selected">selected</xsl:attribute></xsl:if>По названию</option><option value="price-up"><xsl:if test="modern_sort='price-up'"><xsl:attribute name="selected">selected</xsl:attribute></xsl:if>Сначала дешевле</option><option value="price-down"><xsl:if test="modern_sort='price-down'"><xsl:attribute name="selected">selected</xsl:attribute></xsl:if>Сначала дороже</option></select></label><button class="btn" type="submit">Показать модели</button><a class="reset" href="/modern-catalog/">Сбросить фильтры</a></form></aside><section aria-label="Результаты подбора"><div class="toolbar"><span>Найдено: <strong><xsl:value-of select="total"/></strong></span><span>По 24 товара на странице</span></div><div class="grid"><xsl:choose><xsl:when test="shop_item"><xsl:apply-templates select="shop_item"/></xsl:when><xsl:otherwise><div class="empty"><h2>Модели не найдены</h2><p>Измените запрос или диапазон цен.</p><a class="btn secondary" href="/modern-catalog/">Показать все модели</a></div></xsl:otherwise></xsl:choose></div><nav class="pagination" aria-label="Страницы каталога"><xsl:if test="page &gt; 0"><a class="btn secondary" href="{modern_query}{page}">Предыдущая</a></xsl:if><span>Страница <xsl:value-of select="page+1"/></span><xsl:if test="total &gt; (page+1)*limit"><a class="btn secondary" href="{modern_query}{page+2}">Следующая</a></xsl:if></nav></section></div></main>
	<footer class="footer"><div class="wrap"><div><strong>КЛИМАТ-СЕРВИС</strong><p>Климатические решения для дома и бизнеса.<br/>Москва и Московская область.</p></div><div><strong><a href="tel:+79054113948">+7 (905) 411-39-48</a></strong><p>Москва, ул. Перовская, 20<br/><a href="/delivery/">Доставка и оплата</a> · <a href="/kontakty/">Контакты</a></p></div></div></footer></body></html></xsl:template>
<xsl:template match="shop_item"><article class="product"><a class="product-image" href="{url}"><xsl:choose><xsl:when test="image_small!=''"><img src="{dir}{image_small}" alt="{name}" width="360" height="270" loading="lazy" decoding="async"/></xsl:when><xsl:otherwise><span class="eyebrow">Изображение уточняется</span></xsl:otherwise></xsl:choose></a><span class="sku">Код модели: <xsl:value-of select="@id"/></span><h2><a href="{url}"><xsl:value-of select="name"/></a></h2><div class="bottom"><xsl:choose><xsl:when test="price &gt; 0"><strong class="price"><xsl:value-of select="format-number(price,'# ##0','ru')"/><xsl:text> </xsl:text><xsl:value-of select="currency"/></strong><xsl:if test="discount &gt; 0"><del class="old"><xsl:value-of select="format-number(price+discount,'# ##0','ru')"/><xsl:text> </xsl:text><xsl:value-of select="currency"/></del></xsl:if></xsl:when><xsl:otherwise><strong class="price" style="font-size:16px">Цена по запросу</strong></xsl:otherwise></xsl:choose><div class="actions"><a class="btn secondary" href="{url}">Подробнее</a><xsl:if test="price &gt; 0 and not(modifications/shop_item)"><a class="btn" href="{/shop/url}cart/?add={@id}&amp;count=1">В корзину</a></xsl:if></div></div></article></xsl:template></xsl:stylesheet>