th,.info-copy td{padding:12px 14px;border:1px solid var(--line);vertical-align:top}.info-copy th{text-align:left;background:#f4f8fa;font-weight:600}.info-copy pre{max-width:100%;overflow-x:auto}.info-copy blockquote{margin:24px 0;padding:16px 20px;border-left:3px solid var(--blue);background:#f4f8fa}.info-copy .container{width:auto;max-width:none;margin:0;padding:0}.info-copy .contacts,.info-copy .contacts__list{list-style:none;margin:0;padding:0}.info-copy .contacts__box{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:26px;align-items:start}.info-copy .contacts__list{display:grid;gap:16px}.info-copy .contacts__item+.contacts__item{margin-top:0}.info-copy .contacts__item p{margin:0}.info-copy .contacts__item--phone a{font-size:21px;line-height:1.5;font-weight:600;text-decoration:none}.info-copy .contacts__item--email a{font-size:14px}.info-copy .contacts__map{min-width:0;min-height:300px}.info-copy .feedback{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:30px;padding:22px;border:1px solid #dce9ec;border-radius:14px;background:#f0f7f8}.info-copy .feedback p{margin:0;font-size:14px;line-height:1.8}.info-copy .feedback a[href="/kontakty/feedback/"]{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;min-height:44px;padding:10px 18px;border-radius:9px;background:var(--blue);color:#fff;font-size:13px;font-weight:600;text-decoration:none}.info-copy .feedback a[href="/kontakty/feedback/"]:hover{background:#006783}
@media(max-width:1000px){.info-layout{grid-template-columns:190px minmax(0,1fr);gap:18px}.info-sidebar{padding:18px 12px}.info-content{padding:28px}.info-copy .contacts__box{grid-template-columns:1fr;gap:24px}.info-copy .feedback{align-items:flex-start;flex-direction:column;gap:16px}}
@media(max-width:760px){.info-page{padding-top:16px;padding-bottom:32px}.info-breadcrumbs{margin-bottom:16px;font-size:11px}.info-layout{grid-template-columns:1fr;gap:16px}.info-sidebar{position:static;padding:8px;border-radius:12px}.info-kicker,.info-catalog{display:none}.info-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px}.info-nav a{display:flex;align-items:center;justify-content:center;min-height:48px;padding:8px 6px;font-size:12px;line-height:1.5;text-align:center}.info-content{padding:24px 20px;border-radius:14px}.info-title,.info-copy h1{font-size:27px;line-height:1.3;margin-bottom:20px}.info-copy{font-size:14px;line-height:1.8}.info-copy h2{font-size:21px;margin-top:26px}.info-copy h3{font-size:18px}.info-copy th,.info-copy td{padding:10px;font-size:13px}.info-copy .feedback{padding:18px}.info-copy .contacts__item--phone a{font-size:20px}}
