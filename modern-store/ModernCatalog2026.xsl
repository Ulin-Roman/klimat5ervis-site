tAttribute('data-display-sizes');if(set){image.setAttribute('srcset',set)}else{image.removeAttribute('srcset')}if(sizes){image.setAttribute('sizes',sizes)}else{image.removeAttribute('sizes')}link.href=a.href;document.querySelectorAll('.photo-thumb').forEach(function(t){t.removeAttribute('aria-current')});a.setAttribute('aria-current','true')})});]]></script></xsl:template>
