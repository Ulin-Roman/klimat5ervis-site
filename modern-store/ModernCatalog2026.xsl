ue-of select="."/><span aria-hidden="true"> ×</span></a></xsl:for-each></div><div class="toolbar"><span>Найдено: <strong><xsl:value-of select="total"/></strong></span><span>По 24 товара на странице</span></div><div class="grid"><xsl:choose><xsl:when test="shop_item"><xsl:apply-templates select="shop_item"/></xsl:when><xsl:otherwise><div class="empty"><h2>Модели не найдены</h2><p>Измените запрос или выбранные фильтры.</p><a class="btn secondary" href="{modern_form_action}">Сбросить фильтры</a></div></xsl:otherwise></xsl:choose></div><nav class="pagination" aria-label="Страницы каталога"><xsl:if test="page &gt; 0"><a class="btn secondary" href="{modern_query}{page}">Предыдущая</a></xsl:if><span>Страница <xsl:value-of select="page+1"/></span><xsl:if test="total &gt; (page+1)*limit"><a class="btn secondary" href="{modern_query}{page+2}">Следующая</a></xsl:if></nav></section></div></xsl:otherwise></xsl:choose></main>
