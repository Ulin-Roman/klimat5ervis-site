+/* Shared header and gently rounded components. Loaded after the original theme. */
+:root{--ks-blue:#0089c9;--ks-ink:#142634;--ks-line:#dfe8ed;--ks-radius:16px}
+html{scroll-padding-top:100px}
+.main-header.ks-header{position:sticky;top:0;z-index:1000;padding:0;background:#fff;border-bottom:1px solid #e7edf1;box-shadow:0 4px 20px #12364a08}
+.ks-header>.ks-header-row{display:flex;align-items:center;gap:18px;min-height:84px;width:100%;padding:0 15px}
+.ks-brand{display:flex;align-items:center;gap:10px;flex-shrink:0;color:var(--ks-ink);text-decoration:none}
+.ks-brand img{width:42px;height:36px;object-fit:contain}
+.ks-brand span{display:block;white-space:nowrap}
+.ks-brand strong{display:block;font-size:19px;font-weight:800;line-height:1.25;text-transform:uppercase;color:#142634}
+.ks-brand small{display:block;font-size:10px;line-height:1.5;letter-spacing:.05em;color:#73808b}
+.ks-navigation{margin-left:auto;min-width:0}
+.ks-header .main-nav{display:flex;align-items:center;flex-wrap:nowrap;gap:1px;margin:0;padding:0;list-style:none}
+.ks-header .main-nav__link,.ks-header .main-nav__item:first-child .main-nav__link{display:block;padding:12px 10px;font-size:14px;line-height:20px;white-space:nowrap;font-weight:600;color:var(--ks-ink);background:transparent;border-radius:10px}
+.ks-header .main-nav__item:hover>.main-nav__link-box>.main-nav__link,.ks-header .main-nav__item:focus-within>.main-nav__link-box>.main-nav__link,.ks-header .main-nav__item--current>.main-nav__link-box>.main-nav__link{color:#006d9e;background:#eef8fc}
+.ks-header .main-nav__item:first-child .main-nav__link{padding-right:31px}
+.ks-submenu-toggle{position:absolute;right:0;top:0;width:29px;height:44px;border:0;background:transparent;color:#147ba4;border-radius:10px;cursor:pointer;padding:6px}
+.ks-submenu-toggle svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
+.ks-header .main-nav__dropdown{display:none;position:absolute;top:100%;left:0;width:280px;max-width:calc(100vw - 30px);margin:0;padding:10px;opacity:1;visibility:visible;background:#fff;border:1px solid var(--ks-line);border-radius:16px;box-shadow:0 12px 32px #17384c20;transition:none}
+.ks-header .main-nav__dropdown a{padding:11px 12px;color:var(--ks-ink);font-size:14px;line-height:1.4;background:transparent;border-radius:9px}
+.ks-header .main-nav__dropdown a:hover,.ks-header .main-nav__dropdown a:focus-visible{background:#eef8fc;color:#006d9e}
+.ks-header .ks-submenu-open>.main-nav__dropdown{display:block}
+.ks-tools{display:flex;align-items:center;flex-shrink:0;gap:6px}
+.ks-icon{display:inline-flex;align-items:center;justify-content:center;width:38px;height:42px;flex-shrink:0;padding:8px;border:0;border-radius:11px;background:transparent;color:#264454;cursor:pointer;line-height:1}
+.ks-icon:hover,.ks-icon[aria-expanded="true"]{background:#edf7fb;color:#007cb6}
+.ks-icon>svg{display:block;width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
+.ks-messengers{display:flex;align-items:center;gap:8px;padding:0 4px}
+.ks-messengers a{display:flex;align-items:center;justify-content:center;min-width:38px;min-height:44px;border-radius:12px;transition:transform .15s}
+.ks-messengers a:hover{transform:translateY(-2px)}
+.ks-messengers img{display:block;width:34px;height:34px;object-fit:contain}
+.ks-header .header-actions{display:flex;align-items:center;gap:6px;margin:0;padding:0}
+.ks-header .header-actions__link{width:40px;height:42px;min-width:0;padding:7px;border-radius:11px;background:#f1f7fa}
+.ks-header .header-actions__item--basket .header-actions__link{background:#fff2a6;width:44px}
+.ks-header .header-actions__link:hover{background:#ddecf4}
+.ks-header .header-actions__item--basket .header-actions__link:hover{background:#ffe974}
+.ks-header .header-actions__icon-box{margin:0!important;display:flex}
+.ks-header .header-actions__icon{width:23px;height:23px;fill:#264454}
+.ks-header .header-actions__counter{top:-9px;right:-9px;width:17px;height:17px;font-size:10px;line-height:1;color:#fff;background:#007db5}
+.ks-header .header-actions__item--favorites .header-actions__counter{background:#d7e8f1;color:#264454}
+.ks-header .header-actions__item{height:auto;align-items:center}
+.ks-header .header-actions__text{display:block;position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
+.ks-menu-toggle,.ks-menu-cross,.ks-mobile-search,.ks-mobile-contact{display:none}
+.ks-popover{position:absolute;right:15px;top:calc(100% + 10px);padding:18px;background:#fff;border:1px solid var(--ks-line);border-radius:16px;box-shadow:0 12px 36px #17384c22;max-width:calc(100vw - 30px)}
+.ks-popover[hidden],.ks-backdrop[hidden]{display:none!important}
+.ks-search-panel{width:540px}
+.ks-search-form{display:flex;align-items:center;width:100%;border:1px solid #cbdfe9;border-radius:12px;background:#f7fbfd;overflow:hidden}
