+/* One text family and a restrained hierarchy across shared templates. */
+body,button,input,select,textarea,.irs,.tooltipster-default .tooltipster-content{font-family:"Open Sans",Tahoma,sans-serif}
+.page h1,.formblock h1,.formpage h1,.messagecart h1{font-family:"Open Sans",Tahoma,sans-serif;font-size:28px;font-weight:600;line-height:1.3}
+.page .content h2,.product-tabs__content h2,.catalog-info h2{font-size:22px;font-weight:600;line-height:1.4}
+.page .content h3,.product-tabs__content h3,.catalog-info h3{font-size:18px;font-weight:600;line-height:1.4}
+.head-section h2,.head-section h3,.top-sales>h3,.stock-slider>h3{font-size:18px;font-weight:600;line-height:1.4}
+.news__item .news__content h2,.news__item .news__content h3{font-size:17px;font-weight:600;line-height:1.4}
+.page .content>p,.page .content>ul:not([class])>li,.page .content>ol:not([class])>li,.news_page p,.news_page li,.catalog-info p,.catalog-info li,.product-tabs__content p,.product-tabs__content li,.about-index__content p,.about-index__content li{font-size:15px;line-height:1.6}
+.news_page p,.news_page li,.product-tabs__content p,.product-tabs__content li{font-family:"Open Sans",Tahoma,sans-serif}
+.news_page p span,.news_page li span,.product-tabs__content p span,.product-tabs__content li span{font-family:inherit!important}
+.button,.buttonmedium,.buttonlarge,.filter_enable,.filter_reset,.filter-search,.checkout__button,.head-section a,.offer-slider__button,.feedback>a:last-child{font-family:"Open Sans",Tahoma,sans-serif;font-weight:600;line-height:1.4}
+.feedback p{font-size:18px;line-height:1.6}
+.feedback>a:last-child{font-size:16px}
+.news__img{object-fit:cover}
+@media(max-width:767px){.page h1,.formblock h1,.formpage h1,.messagecart h1{font-size:24px}.page .content h2,.product-tabs__content h2,.catalog-info h2{font-size:20px}.feedback p{font-size:16px}}
