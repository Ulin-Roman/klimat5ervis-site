+.product-card__buttons .product-card__button--buy:hover,.product-card__buttons .product-card__button--buy:focus{background:#dce5eb;color:#172d3b}
+.nice-number{border-radius:10px;overflow:hidden}
+.gallery-side__item img,.gallery__item{border-radius:12px}
+.product-tabs .product-tabs__head{gap:8px;margin:0 0 14px;padding:0;background:transparent;border:0}
+.product-tabs .product-tabs__head li{margin:0;border:0;border-radius:12px;overflow:hidden}
+.product-tabs .product-tabs__head a{padding:14px 24px;border-radius:12px;font-family:inherit;font-size:16px;font-weight:600;line-height:1.4;background:#edf2f5;color:#263642}
+.product-tabs .product-tabs__head .ui-tabs-active a{background:#0076ac;color:#fff}
+.product-tabs .product-tabs__head a:focus-visible{outline:2px solid #173b52;outline-offset:-4px}
+.product-tabs .product-tabs__content{border:1px solid #dce5eb;border-radius:16px;padding:28px 32px}
+.news__img-box{border-radius:16px;overflow:hidden}
+.news__img{border-radius:16px}
+.news__date{border-radius:12px;background:#edf2f5;color:#263642;box-shadow:0 2px 10px #17384c12}
+.ks-cookie-notice[hidden],#ks-cookie-details[hidden]{display:none!important}
+.ks-cookie-notice{position:fixed;z-index:1200;left:20px;bottom:20px;width:min(480px,calc(100% - 40px));display:flex;align-items:center;flex-wrap:wrap;gap:10px 16px;padding:14px 16px;background:#fff;color:#263642;border:1px solid #dce5eb;border-radius:14px;box-shadow:0 8px 32px #17384c26;font:14px/1.5 "Open Sans",Tahoma,sans-serif}
+.ks-cookie-copy{flex:1 1 240px;min-width:0}
+.ks-cookie-copy p,.ks-cookie-notice #ks-cookie-details{margin:0}
+.ks-cookie-details-toggle,.ks-cookie-settings{font:inherit;color:#0076ac;background:transparent;border:0;text-decoration:underline;cursor:pointer;padding:0;min-height:24px}
+.ks-cookie-notice .ks-cookie-dismiss{flex:0 0 auto;min-height:44px;padding:10px 16px;border:0;border-radius:10px;background:#0076ac;color:#fff;font:600 14px/1.4 "Open Sans",Tahoma,sans-serif;cursor:pointer}
+.ks-cookie-notice .ks-cookie-dismiss:hover{background:#005e89}
+.ks-cookie-notice button:focus-visible,.ks-cookie-settings:focus-visible{outline:2px solid #0076ac;outline-offset:3px}
+.main-footer .ks-cookie-settings{display:block;margin:8px 0 0 64px;font-size:12px;line-height:1.5}
+.main-footer .ks-cookie-settings.main-footer__agreement--mobile{display:none}
+#ks-cookie-details{flex:1 0 100%;border-top:1px solid #e4eaee;padding-top:10px;font-size:12px}
+@media(max-width:767px){.product-tabs .product-tabs__head a{padding:12px 14px;font-size:15px}.product-tabs .product-tabs__content{padding:20px 16px}.ks-cookie-notice{left:12px;bottom:12px;width:calc(100% - 24px);padding:12px;gap:8px 12px}.ks-cookie-copy{flex-basis:180px}.ks-cookie-notice .ks-cookie-dismiss{margin-left:auto}.main-footer .ks-cookie-settings.main-footer__agreement--desktop{display:none}.main-footer .ks-cookie-settings.main-footer__agreement--mobile{display:block;margin:8px auto 0}}
