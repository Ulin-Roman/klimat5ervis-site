+/* Shared footer messenger links and neutral feedback panel. */
+.main-footer .ks-footer-messengers{display:flex;align-items:center;gap:8px;margin-top:10px}
+.main-footer .ks-footer-messengers>a{display:inline-flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px;height:44px;border-radius:12px;line-height:1;text-decoration:none}
+.main-footer .ks-footer-messengers>a::after{display:none}
+.main-footer .ks-footer-messengers>a:hover{background:#dfe7ec}
+.main-footer .ks-footer-messengers>a:focus-visible{outline:2px solid #0076ac;outline-offset:2px}
+.main-footer .ks-footer-messengers img{display:block;width:36px;height:36px}
+.page .feedback{background:#f1f4f6;border:1px solid #dde4e8;color:#263642}
+.main-footer .user__item:last-child::before{background-image:url("/assets/footer-20261116/support-neutral.svg")}
